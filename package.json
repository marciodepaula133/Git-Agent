{
  "name": "@marciodepaula133/git-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code skills backed by one shared git/GitHub subagent, bundled directly into each skill folder so it installs via the generic `skills` CLI with no separate npm publish step.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-reporter=spec \"dist/**/*.test.js\"",
    "bundle": "node scripts/bundle-skill-subagents.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
